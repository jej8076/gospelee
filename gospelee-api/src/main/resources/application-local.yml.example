server:
  port: 8008
  domain: http://<YOUR_LOCAL_IP>:8008
  servlet:
    context-path: /api

cors:
  allowed-origins:
    - http://localhost:3000
    - http://<YOUR_LOCAL_IP>:3000

spring:
  application:
    name: api
  servlet:
    multipart:
      max-file-size: 20MB
      max-request-size: 20MB
  datasource:
    url: jdbc:postgresql://localhost:5433/podo
    username: <DB_USER>
    password: <DB_PASSWORD>
    hikari:
      pool-name: HikariCP
      maximum-pool-size: 10
      connection-timeout: 10000
      validation-timeout: 10000
      max-lifetime: 580000
      connection-init-sql: SELECT 1
      data-source-properties:
        sslmode: require
        # Teleport SSL 인증서 경로 (본인 OS에 맞게 수정)
        # macOS: /Users/<user>/.tsh/keys/...
        # Linux: /home/<user>/.tsh/keys/...
        # WSL: \\wsl.localhost\Ubuntu-24.04\home\<user>\.tsh\keys\...
        sslcert: <PATH_TO>/.tsh/keys/teleport.po-do.org/jej-db/po-do.org/podo-postgresql.crt
        sslkey: <PATH_TO>/.tsh/keys/teleport.po-do.org/jej-db/po-do.org/podo-postgresql.pk8
        sslrootcert: <PATH_TO>/.tsh/keys/teleport.po-do.org/cas/po-do.org.pem
  jpa:
    hibernate:
      ddl-auto: none
    properties:
      show_sql: true
      format_sql: true
  cache:
    type: redis
    redis:
      cache-null-values: true
  data:
    redis:
      repositories:
        enabled: false

springdoc:
  default-consumes-media-type: application/json;charset=UTF-8
  swagger-ui:
    path: /swagger-ui.html
    disable-swagger-default-url: true
    display-query-params-without-oauth2: true

redis:
  embedded: true
  host: localhost
  port: 6377

auth:
  super-id: super@super.com
  super-pass: <SUPER_PASS_TOKEN>
  exclude-paths:
    - /bible/view/*
    - /account/qr/enter
    - /account/qr/check
    - /account/nonce/put
    - /account/appstore/token
    - /file/*
    - /app-link/*
    - /article/*
    - /youtube/videos
    - /announcement/unauthorized/BRAND_STORY
  allow-pending-paths:
    - /api/account/qr/req/*
  app-store-skip-email: <APPLE_REVIEW_TEST_EMAIL>

kakao:
  issuer: https://kauth.kakao.com
  app-key: <KAKAO_APP_KEY>

apple:
  issuer: https://appleid.apple.com
  app-key: org.podo

firebase:
  admin-sdk:
    # Firebase service account JSON 경로 (본인 OS에 맞게 수정)
    path: <PATH_TO>/firebase/podo-d55b1-firebase-adminsdk-fbsvc-f086c21401.json
